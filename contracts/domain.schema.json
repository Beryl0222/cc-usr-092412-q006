{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "公园节令联名履约领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "DESIGN_CLEARED",
        "COMPONENT_ACCEPTED",
        "COMPONENT_INSPECTION_RECORDED",
        "COMPONENT_SHORTAGE_DECLARED",
        "COMPONENT_RESERVATION_ACQUIRED",
        "COMPONENT_RESERVATION_RELEASED",
        "COMPONENT_RESERVATION_CONSUMED",
        "LABEL_SNAPSHOT_PUBLISHED",
        "ASSEMBLY_VERSION_PUBLISHED",
        "BUNDLE_RELEASED",
        "CHANNEL_QUOTA_CONFIGURED",
        "CHANNEL_QUOTA_RESERVED",
        "CHANNEL_QUOTA_RELEASED",
        "CHANNEL_QUOTA_CONSUMED",
        "CHANNEL_QUOTA_TRANSFERRED",
        "ORDER_RESERVED",
        "COMMITMENT_FULFILLED",
        "COMMITMENT_FROZEN",
        "COMMITMENT_MIGRATED",
        "BOX_ASSEMBLED",
        "BOX_REDEEMED",
        "REORGANIZATION_PROPOSED",
        "REORGANIZATION_LABEL_CONFIRMED",
        "REORGANIZATION_QUOTA_CONFIRMED",
        "REORGANIZATION_PARTNER_REFUSED",
        "REORGANIZATION_ITEM_EXECUTED",
        "IMPACT_NOTIFICATION_APPENDED",
        "LIABILITY_ASSIGNED",
        "RECEIPT_SUBMITTED",
        "RECEIPT_MERGED",
        "RECEIPT_CONFLICT_DETECTED",
        "SETTLEMENT_PAUSED",
        "SETTLEMENT_CLEARED",
        "REMEDY_COMPLETED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "collaboration_design",
        "component_lot",
        "bundle_batch",
        "customer_order",
        "label_snapshot",
        "assembly_version",
        "channel_quota",
        "reorganization_plan",
        "fulfillment_receipt",
        "bundle_unit",
        "partner_liability"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
